{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "development",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "695435119958-8jk9573rf5mismppne2ig5r8ucgs2mh8.apps.googleusercontent.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_DISABLE_NATIVE_DEBUG_UPLOAD": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://warsh-git-staging-warshapp-projects.vercel.app",
        "EXPO_PUBLIC_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "695435119958-8jk9573rf5mismppne2ig5r8ucgs2mh8.apps.googleusercontent.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_DISABLE_NATIVE_DEBUG_UPLOAD": "true"
      }
    },
    "previewProd": {
      "distribution": "internal",
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.warsh.app",
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "695435119958-8jk9573rf5mismppne2ig5r8ucgs2mh8.apps.googleusercontent.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_DISABLE_NATIVE_DEBUG_UPLOAD": "true"
      }
    },
    "production": {
      "credentialsSource": "local",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.warsh.app",
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "695435119958-8jk9573rf5mismppne2ig5r8ucgs2mh8.apps.googleusercontent.com",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_DISABLE_NATIVE_DEBUG_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "alpha"
      }
    }
  }
}

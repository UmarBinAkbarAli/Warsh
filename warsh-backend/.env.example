# Local development defaults. Do not commit .env, .env.local, or real secrets.

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/warsh_dev"
# DIRECT_DATABASE_URL is required only when using a separate migration URL in hosted environments.
DIRECT_DATABASE_URL=""

# Auth
JWT_SECRET="replace-with-a-random-string-at-least-32-characters"
JWT_EXPIRES_IN="30d"
# OAuth 2.0 Web client ID from the Warsh Production Google Cloud project.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_IDS=""

# Feature flags
DEV_UNLOCK_ALL=false

# Admin content-authoring endpoints (app/api/admin/*). Required in production —
# writes (and the /api/admin/content read) are rejected with no token configured.
ADMIN_DASHBOARD_TOKEN=""
# Only set to "true" for local development to skip the admin token check entirely.
# Ignored outside NODE_ENV=development — never enables in production.
ALLOW_UNAUTHENTICATED_ADMIN=false

# Noor / AI
AI_DAILY_MESSAGE_LIMIT=5
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TTS_MODEL="tts-1"
OPENAI_TTS_VOICE="onyx"
TTS_DAILY_LIMIT=50

# Cloudflare R2 assets. Required before beta content uses remote audio/images.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="warsh-assets"
R2_PUBLIC_URL="https://assets.warsh.app"
R2_ENDPOINT=""

# Mobile IAP / store integrations. Configure real values only in Vercel/CI secrets.
APPLE_SHARED_SECRET=""
APPLE_BUNDLE_ID="com.warsh.app"
APPLE_NOTIFICATION_WEBHOOK_SECRET=""
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=""
GOOGLE_PLAY_PACKAGE_NAME="com.warsh.app"
# Legacy shared secret for the RTDN webhook, passed as ?token=. Compared in
# constant time, but it travels in the URL. Prefer the OIDC pair below.
GOOGLE_PLAY_NOTIFICATION_WEBHOOK_SECRET=""
# Preferred RTDN auth: verify the OIDC identity token Pub/Sub attaches to each
# push. Set BOTH to enable; the shared secret above is then ignored.
# AUDIENCE is the audience configured on the Pub/Sub push subscription.
# SERVICE_ACCOUNT is the email of the account Pub/Sub pushes as.
GOOGLE_PLAY_PUBSUB_AUDIENCE=""
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=""

# Cron jobs. Set a strong random secret and add it to Vercel environment variables.
CRON_SECRET=""

# Rate limiting. Without these, limits are per-instance and reset on deploy —
# fine locally, not a real limit on serverless. Set both in production to get
# shared, cross-instance limits (https://console.upstash.com).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email for password reset (Resend). Get a key at resend.com.
RESEND_API_KEY=""
SMTP_FROM_EMAIL="noreply@warsh.app"

# Legacy SMTP (not used — kept for reference)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# Analytics and errors. Leave blank to disable locally.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
MIXPANEL_TOKEN=""

# Runtime
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # production: https://api.warsh.app
PUBLIC_SITE_URL="https://warsh.app"
NODE_ENV="development"
LOG_LEVEL="debug"

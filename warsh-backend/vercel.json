{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reset-streaks",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/expire-trials",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/production-probe",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reconcile-voided-purchases",
      "schedule": "30 3 * * *"
    }
  ]
}

  "discover_cards": [
    {
      "type": "CONCEPT",
      "concept": {
        "en": "مَنْصُوب — fatḥa",
        "ar": "النَّصْبُ",
        "ur": "مَنْصُوب — فتحہ"
      },
      "explanation": {
        "en": "After أَنْ (\"that / to\") and لَنْ (\"will not\"), a regular present-tense verb ends in fatḥa: أَنْ يَذْهَبَ, لَنْ يَذْهَبَ.",
        "ur": "أَنْ (\"کہ\") اور لَنْ (\"ہرگز نہیں\") کے بعد عام مضارع فعل فتحہ پر ختم ہوتا ہے: أَنْ يَذْهَبَ، لَنْ يَذْهَبَ۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "أُرِيدُ أَنْ أَذْهَبَ",
        "ar_plain": "اريد ان اذهب",
        "translit": "uriidu an adh-haba",
        "en": "I want to go.",
        "ur": "میں جانا چاہتا ہوں۔"
      },
      "explanation": {
        "en": "أَنْ is the particle; أُرِيدُ (\"I want\") is a verb that comes before it. After أَنْ: أَذْهَبَ (fatḥa).",
        "ur": "أَنْ حرف ہے؛ أُرِيدُ (\"میں چاہتا ہوں\") اس سے پہلے آنے والا فعل ہے۔ أَنْ کے بعد: أَذْهَبَ (فتحہ)۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "لَنْ يَذْهَبَ",
        "ar_plain": "لن يذهب",
        "translit": "lan yadh-haba",
        "en": "he will not go (مَنْصُوب)",
        "ur": "وہ نہیں جائے گا (منصوب)"
      },
      "explanation": {
        "en": "لَنْ = \"will not\". لَنْ يَذْهَبَ = \"he will not go\". It is not a word for \"never\" or \"absolutely\".",
        "ur": "لَنْ = \"نہیں … گا\"۔ لَنْ يَذْهَبَ = \"وہ نہیں جائے گا\"۔ یہ \"کبھی نہیں\" یا \"بالکل\" کا لفظ نہیں۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "قَالُوا لَنْ نَبْرَحَ عَلَيْهِ عَاكِفِينَ",
        "ar_plain": "قالوا لن نبرح عليه عاكفين",
        "translit": "qaaluu lan nabraha 'alayhi 'aakifiin",
        "en": "They said, 'We will not stop being devoted to it.' (Ta-Ha 20:91)",
        "ur": "انہوں نے کہا: 'ہم اسی پر جمے رہیں گے۔' (طٰہٰ 20:91)"
      },
      "explanation": {
        "en": "لَنْ نَبْرَحَ: fatḥa on the ح.",
        "ur": "لَنْ نَبْرَحَ: ح پر فتحہ۔"
      }
    },
    {
      "type": "GRAMMAR_NOTE",
      "title": {
        "en": "Scope",
        "ur": "دائرہ"
      },
      "body": {
        "en": "This lesson uses أَنْ and لَنْ. Other particles that take مَنْصُوب verbs (كَيْ, حَتَّى …) come in their own lessons. These rules are for regular verbs like يَذْهَبُ. Verbs ending in a long vowel and the five verbs (يَذْهَبُونَ …) show their states differently — studied later.",
        "ur": "یہ سبق أَنْ اور لَنْ استعمال کرتا ہے۔ منصوب فعل لینے والے دوسرے حروف (كَيْ، حَتَّى …) اپنے اسباق میں آئیں گے۔ یہ قاعدے يَذْهَبُ جیسے عام افعال کے لیے ہیں۔ لمبی آواز پر ختم ہونے والے افعال اور افعالِ خمسہ (يَذْهَبُونَ …) اپنی حالتیں الگ طرح دکھاتے ہیں — آگے پڑھیں گے۔"
      }
    }
  ],

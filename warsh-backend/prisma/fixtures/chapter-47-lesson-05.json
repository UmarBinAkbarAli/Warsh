    "chapter_order": 47,
    "lesson_order": 5,
    "chapter_title": "Sound Masculine Plural — Full Treatment",
    "title": "Plural Noun or Plural Verb?",
    "titleAr": "اسْمٌ أَمْ فِعْلٌ؟",
    "estimated_minutes": 8,
    "xp_reward": 10,
    "titleUr": "جمع اسم یا جمع فعل؟"
  },
  "hook": {
    "ayah": {
      "surah": 2,
      "ayah": 5,
      "label": "Al-Baqarah 2:5",
      "ar": "أُولَٰئِكَ عَلَىٰ هُدًى مِنْ رَبِّهِمْ ۖ وَأُولَٰئِكَ هُمُ الْمُفْلِحُونَ",
      "en": "Those are on guidance from their Lord, and it is they who are the successful.",
      "ur": "یہی لوگ اپنے رب کی طرف سے ہدایت پر ہیں اور یہی کامیاب ہیں۔",
      "audio_url": "https://everyayah.com/data/Alafasy_128kbps/002005.mp3"
    },
    "autoplay": true,
    "noor_intro": {
      "en": "الْمُفْلِحُونَ ends in ـُونَ — and so does يُؤْمِنُونَ. One is a noun, the other a verb. Today you tell them apart.",
      "ur": "الْمُفْلِحُونَ ـُونَ پر ختم ہوتا ہے — اور يُؤْمِنُونَ بھی۔ ایک اسم ہے، دوسرا فعل۔ آج آپ ان میں فرق کریں گے۔"
    }
  },
  "discover_cards": [
    {
      "type": "CONCEPT",
      "concept": {
        "en": "Same ending, different words",
        "ar": "اسْمٌ أَمْ فِعْلٌ",
        "ur": "ایک لاحقہ، الگ الفاظ"
      },
      "explanation": {
        "en": "الْمُؤْمِنُونَ (noun: \"the believers\") — can take ال, and its ending shows case. يُؤْمِنُونَ (imperfect verb: \"they believe\") — starts with a present-tense prefix يُـ. آمَنُوا (perfect verb: \"they believed\") — ends in ـُوا.",
        "ur": "الْمُؤْمِنُونَ (اسم: \"ایمان والے\") — ال لے سکتا ہے، اور اس کا لاحقہ اعراب بتاتا ہے۔ يُؤْمِنُونَ (مضارع: \"وہ ایمان لاتے ہیں\") — مضارع کے سابقے يُـ سے شروع ہوتا ہے۔ آمَنُوا (ماضی: \"وہ ایمان لائے\") — ـُوا پر ختم ہوتا ہے۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "الْمُؤْمِنُونَ",
        "ar_plain": "المؤمنون",
        "translit": "al-mu'minuuna",
        "en": "the believers (nominative)",
        "ur": "مومن (مرفوع)"
      },
      "explanation": {
        "en": "A noun: ال at the start, case ending ـُونَ.",
        "ur": "اسم: شروع میں ال، اعراب کا لاحقہ ـُونَ۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "يُؤْمِنُونَ",
        "ar_plain": "يؤمنون",
        "translit": "yu'minuuna",
        "en": "they believe (imperfect verb)",
        "ur": "وہ ایمان لاتے ہیں (مضارع)"
      },
      "explanation": {
        "en": "A verb: the prefix يُـ. Its ـُونَ belongs to the five verbs, not to noun case.",
        "ur": "فعل: سابقہ يُـ۔ اس کا ـُونَ افعالِ خمسہ کا ہے، اسم کے اعراب کا نہیں۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "آمَنُوا",
        "ar_plain": "امنوا",
        "translit": "aamanuu",
        "en": "they believed (perfect verb)",
        "ur": "وہ ایمان لائے (ماضی)"
      },
      "explanation": {
        "en": "A past verb: ends in ـُوا.",
        "ur": "ماضی کا فعل: ـُوا پر ختم ہوتا ہے۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "وَأُولَٰئِكَ هُمُ الْمُفْلِحُونَ",
        "ar_plain": "واولئك هم المفلحون",
        "translit": "wa ulaa-ika humul-muflihuun",
        "en": "and it is they who are the successful (2:5)",
        "ur": "اور یہی کامیاب ہیں (2:5)"
      },
      "explanation": {
        "en": "الْمُفْلِحُونَ: a noun with ال, nominative.",
        "ur": "الْمُفْلِحُونَ: ال والا اسم، مرفوع۔"
      }
    }
  ],

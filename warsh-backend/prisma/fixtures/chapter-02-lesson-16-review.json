  "discover_cards": [
    {
      "type": "CONCEPT",
      "concept": {
        "en": "The big picture — نَكِرَة vs مَعْرِفَة",
        "ar": "النَّكِرَة وَالْمَعْرِفَة",
        "ur": "بڑی تصویر — نکرہ اور معرفہ"
      },
      "explanation": {
        "en": "Every Arabic noun is either نَكِرَة (indefinite — 'a') or مَعْرِفَة (definite — 'the'). Tanween (ٌ) = نَكِرَة. ال at the front = مَعْرِفَة. These two categories are the foundation of every sentence you'll ever read in Arabic.",
        "ur": "ہر عربی اسم یا تو نکرہ ('ایک') ہے یا معرفہ ('وہ')۔ تنوین (ٌ) = نکرہ۔ آگے ال = معرفہ۔ یہ دو قسمیں ہر اس جملے کی بنیاد ہیں جو آپ عربی میں پڑھیں گے۔"
      },
      "examples": [
        {
          "ar": "كِتَابٌ ← الْكِتَابُ",
          "ar_plain": "كتاب ← الكتاب",
          "translit": "kitābun → al-kitābu",
          "en": "a book → the book",
          "ur": "ایک کتاب → وہ کتاب"
        },
        {
          "ar": "بَيْتٌ ← الْبَيْتُ",
          "ar_plain": "بيت ← البيت",
          "translit": "baytun → al-baytu",
          "en": "a house → the house",
          "ur": "ایک گھر → وہ گھر"
        },
        {
          "ar": "مَسْجِدٌ ← الْمَسْجِدُ",
          "ar_plain": "مسجد ← المسجد",
          "translit": "masjidun → al-masjidu",
          "en": "a mosque → the mosque",
          "ur": "ایک مسجد → وہ مسجد"
        }
      ]
    },
    {
      "type": "CONCEPT",
      "concept": {
        "en": "Sentences — definite subject + indefinite predicate",
        "ar": "الْمُبْتَدَأُ وَالْخَبَرُ",
        "ur": "جملے — معرفہ مبتدأ + نکرہ خبر"

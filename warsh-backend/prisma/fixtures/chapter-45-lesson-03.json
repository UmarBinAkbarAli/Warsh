    "noor_intro": {
      "en": "لَا تُشْرِكْ — \"do not associate\". The لَا of prohibition makes the verb مَجْزُوم: sukūn at the end.",
      "ur": "لَا تُشْرِكْ — \"شریک نہ ٹھہراؤ\"۔ نہی کا لَا فعل کو مَجْزُوم کرتا ہے: آخر میں سکون۔"
    }
  },
  "discover_cards": [
    {
      "type": "CONCEPT",
      "concept": {
        "en": "مَجْزُوم — sukūn",
        "ar": "الْجَزْمُ",
        "ur": "مَجْزُوم — سکون"
      },
      "explanation": {
        "en": "After لَمْ (\"did not\"), لَمَّا (\"not yet\") and the لَا of prohibition (\"do not\"), a regular present-tense verb ends in sukūn: لَمْ يَذْهَبْ, لَا تَذْهَبْ.",
        "ur": "لَمْ (\"نہیں کیا\")، لَمَّا (\"ابھی تک نہیں\") اور نہی کے لَا (\"مت\") کے بعد عام مضارع فعل سکون پر ختم ہوتا ہے: لَمْ يَذْهَبْ، لَا تَذْهَبْ۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "لَمْ يَذْهَبْ",
        "ar_plain": "لم يذهب",
        "translit": "lam yadh-hab",
        "en": "he did not go (مَجْزُوم)",
        "ur": "وہ نہیں گیا (مجزوم)"
      },
      "explanation": {
        "en": "يَذْهَبُ → لَمْ يَذْهَبْ: the ending changes; يَـ stays.",
        "ur": "يَذْهَبُ ← لَمْ يَذْهَبْ: آخر بدلتا ہے؛ يَـ وہی رہتا ہے۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "لَا تَذْهَبْ",
        "ar_plain": "لا تذهب",
        "translit": "laa tadh-hab",
        "en": "don't go (مَجْزُوم)",
        "ur": "مت جاؤ (مجزوم)"
      },
      "explanation": {
        "en": "لَا of prohibition + تَذْهَبْ = \"don't go\". Compare لَا تَذْهَبُ (\"you do not go\") — plain negation, مَرْفُوع.",
        "ur": "نہی کا لَا + تَذْهَبْ = \"مت جاؤ\"۔ لَا تَذْهَبُ (\"تم نہیں جاتے\") سے موازنہ کریں — سادہ نفی، مرفوع۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "يَا بُنَيَّ لَا تُشْرِكْ بِاللَّهِ",
        "ar_plain": "يا بني لا تشرك بالله",
        "translit": "yaa bunayya laa tushrik billaah",
        "en": "O my son, do not associate anything with Allah. (Luqman 31:13)",
        "ur": "اے میرے بیٹے! اللہ کے ساتھ شریک نہ ٹھہرانا۔ (لقمان 31:13)"
      },
      "explanation": {
        "en": "لَا + تُشْرِكْ (sukūn): a prohibition.",
        "ur": "لَا + تُشْرِكْ (سکون): نہی۔"
      }
    },
    {
      "type": "GRAMMAR_NOTE",
      "title": {
        "en": "A command is a different form",
        "ur": "امر الگ صورت ہے"
      },
      "body": {
        "en": "\"Go!\" is اِذْهَبْ — a command form, made differently. It is not the مَجْزُوم imperfect. ذَهَبْ on its own is not a correct word for \"go\".",
        "ur": "\"جاؤ!\" اِذْهَبْ ہے — امر کی صورت، جو الگ طرح بنتی ہے۔ یہ مجزوم مضارع نہیں۔ صرف ذَهَبْ \"جاؤ\" کے لیے درست لفظ نہیں۔"
      }
    }
  ],

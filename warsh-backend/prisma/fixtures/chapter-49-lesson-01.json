    "autoplay": true,
    "noor_intro": {
      "en": "إِنَّ الْإِنْسَانَ — the noun after إِنَّ ends in fatḥa. Today: the two parts of an إِنَّ sentence.",
      "ur": "إِنَّ الْإِنْسَانَ — إِنَّ کے بعد اسم فتحہ پر ختم ہوتا ہے۔ آج: إِنَّ والے جملے کے دو حصے۔"
    }
  },
  "discover_cards": [
    {
      "type": "CONCEPT",
      "concept": {
        "en": "اِسْمُ إِنَّ and خَبَرُ إِنَّ",
        "ar": "اسْمُ إِنَّ وَخَبَرُهَا",
        "ur": "اسمِ إِنَّ اور خبرِ إِنَّ"
      },
      "explanation": {
        "en": "After إِنَّ, the sentence has two parts: اِسْمُ إِنَّ (the noun of إِنَّ) — مَنْصُوب, and خَبَرُ إِنَّ (its predicate) — مَرْفُوع. إِنَّ الْإِنْسَانَ لَفِي خُسْرٍ: الْإِنْسَانَ is the noun of إِنَّ (fatḥa); لَفِي خُسْرٍ is its predicate.",
        "ur": "إِنَّ کے بعد جملے کے دو حصے ہوتے ہیں: اسمِ إِنَّ — منصوب، اور خبرِ إِنَّ — مرفوع۔ إِنَّ الْإِنْسَانَ لَفِي خُسْرٍ: الْإِنْسَانَ، إِنَّ کا اسم ہے (فتحہ)؛ لَفِي خُسْرٍ اس کی خبر ہے۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "إِنَّ اللَّهَ مَعَ الصَّابِرِينَ",
        "ar_plain": "ان الله مع الصابرين",
        "translit": "innallaaha ma'as-saabiriin",
        "en": "Indeed, Allah is with the patient. (Al-Baqarah 2:153)",
        "ur": "بے شک اللہ صبر کرنے والوں کے ساتھ ہے۔ (البقرہ 2:153)"
      },
      "explanation": {
        "en": "اللَّهَ — noun of إِنَّ (fatḥa). مَعَ الصَّابِرِينَ — its predicate.",
        "ur": "اللَّهَ — اسمِ إِنَّ (فتحہ)۔ مَعَ الصَّابِرِينَ — اس کی خبر۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "إِنَّ الْكِتَابَ جَدِيدٌ",
        "ar_plain": "ان الكتاب جديد",
        "translit": "innal-kitaaba jadiid",
        "en": "Indeed, the book is new. (constructed)",
        "ur": "بے شک کتاب نئی ہے۔ (بنائی گئی مثال)"
      },
      "explanation": {
        "en": "Compare الْكِتَابُ جَدِيدٌ. After إِنَّ, الْكِتَابُ → الْكِتَابَ; the predicate جَدِيدٌ stays مَرْفُوع.",
        "ur": "الْكِتَابُ جَدِيدٌ سے موازنہ کریں۔ إِنَّ کے بعد الْكِتَابُ ← الْكِتَابَ؛ خبر جَدِيدٌ مرفوع رہتی ہے۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "إِنَّ هَٰذَا الْكِتَابَ مُفِيدٌ",
        "ar_plain": "ان هذا الكتاب مفيد",
        "translit": "inna haadhal-kitaaba mufiid",
        "en": "Indeed, this book is useful. (constructed)",
        "ur": "بے شک یہ کتاب مفید ہے۔ (بنائی گئی مثال)"
      },
      "explanation": {
        "en": "هَٰذَا has a fixed form, but it is in the place of the noun of إِنَّ; الْكِتَابَ after it shows the fatḥa. مُفِيدٌ is the predicate.",
        "ur": "هَٰذَا کی صورت نہیں بدلتی، مگر یہ اسمِ إِنَّ کی جگہ ہے؛ اس کے بعد الْكِتَابَ پر فتحہ ظاہر ہے۔ مُفِيدٌ خبر ہے۔"
      }
    },
    {
      "type": "GRAMMAR_NOTE",
      "title": {
        "en": "Not مُبْتَدَأ",
        "ur": "مبتدا نہیں"
      },
      "body": {
        "en": "Without إِنَّ, the first noun is the مُبْتَدَأ (nominative). After إِنَّ, call it اِسْمُ إِنَّ — and it is مَنْصُوب.",
        "ur": "إِنَّ کے بغیر پہلا اسم مبتدا (مرفوع) ہوتا ہے۔ إِنَّ کے بعد اسے اسمِ إِنَّ کہیں — اور یہ منصوب ہوتا ہے۔"
      }
    }
  ],

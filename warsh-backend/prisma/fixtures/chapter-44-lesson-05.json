  "discover_cards": [
    {
      "type": "CONCEPT",
      "concept": {
        "en": "Chapter 44 summary",
        "ar": "خُلَاصَةُ الْبَابِ",
        "ur": "باب 44 کا خلاصہ"
      },
      "explanation": {
        "en": "لَمْ + jussive = \"did not\" (لَمْ يَذْهَبْ). لَمَّا + jussive = \"has not yet\" (لَمَّا يَذْهَبْ). The jussive shows at the end of the verb: sukūn, or a dropped نَ in the five verbs.",
        "ur": "لَمْ + مجزوم = \"نہیں کیا\" (لَمْ يَذْهَبْ)۔ لَمَّا + مجزوم = \"ابھی تک نہیں\" (لَمَّا يَذْهَبْ)۔ جزم فعل کے آخر میں ظاہر ہوتا ہے: سکون، یا افعالِ خمسہ میں گرا ہوا نَ۔"
      }
    },
    {
      "type": "GRAMMAR_NOTE",
      "title": {
        "en": "Meaning comes from context",
        "ur": "معنی سیاق سے آتا ہے"
      },
      "body": {
        "en": "لَمْ = \"did not\"; لَمَّا = \"has not (yet), up to now\". Neither particle by itself says what will happen later — whether something is \"never\" or \"still to come\" comes from the sentence and its context.",
        "ur": "لَمْ = \"نہیں کیا\"؛ لَمَّا = \"اب تک نہیں\"۔ کوئی بھی حرف خود یہ نہیں بتاتا کہ آگے کیا ہو گا — \"کبھی نہیں\" یا \"ابھی ہونا ہے\" کا معنی جملے اور سیاق سے آتا ہے۔"
      }
    }
  ],

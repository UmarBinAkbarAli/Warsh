    "noor_intro": {
      "en": "الْمُؤْمِنُونَ — \"the believers\". It is the subject, so it is in the nominative, and it ends in ـُونَ.",
      "ur": "الْمُؤْمِنُونَ — \"ایمان والے\"۔ یہ فاعل ہے، اس لیے حالتِ رفع میں ہے اور ـُونَ پر ختم ہوتا ہے۔"
    }
  },
  "discover_cards": [
    {
      "type": "CONCEPT",
      "concept": {
        "en": "Sound masculine plural",
        "ar": "جَمْعُ الْمُذَكَّرِ السَّالِمُ",
        "ur": "جمع مذکر سالم"
      },
      "explanation": {
        "en": "Many words for groups of men add an ending to the singular without changing it: مُؤْمِنٌ → مُؤْمِنُونَ, مُسْلِمٌ → مُسْلِمُونَ.",
        "ur": "مردوں کے گروہ کے لیے کئی الفاظ واحد کو بدلے بغیر اس پر لاحقہ لگاتے ہیں: مُؤْمِنٌ ← مُؤْمِنُونَ، مُسْلِمٌ ← مُسْلِمُونَ۔"
      }
    },
    {
      "type": "CONCEPT",
      "concept": {
        "en": "Nominative: ـُونَ",
        "ar": "الرَّفْعُ بِالْوَاوِ",
        "ur": "حالتِ رفع: ـُونَ"
      },
      "explanation": {
        "en": "A sound masculine plural shows its case in its ending: ـُونَ in the nominative (مَرْفُوع) — الْمُؤْمِنُونَ; ـِينَ in the accusative and genitive (مَنْصُوب / مَجْرُور) — الْمُؤْمِنِينَ. Nouns have these three cases; \"jazm\" belongs only to verbs.",
        "ur": "جمع مذکر سالم اپنا اعراب لاحقے سے دکھاتا ہے: حالتِ رفع میں ـُونَ — الْمُؤْمِنُونَ؛ نصب اور جر میں ـِينَ — الْمُؤْمِنِينَ۔ اسم کی یہی تین حالتیں ہیں؛ \"جزم\" صرف فعل کا ہے۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "قَدْ أَفْلَحَ الْمُؤْمِنُونَ",
        "ar_plain": "قد افلح المؤمنون",
        "translit": "qad aflahal-mu'minuun",
        "en": "The believers have certainly succeeded. (Al-Mu'minun 23:1)",
        "ur": "یقیناً ایمان والے کامیاب ہو گئے۔ (المؤمنون 23:1)"
      },
      "explanation": {
        "en": "الْمُؤْمِنُونَ is the subject of أَفْلَحَ: nominative, ـُونَ.",
        "ur": "الْمُؤْمِنُونَ، أَفْلَحَ کا فاعل ہے: مرفوع، ـُونَ۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "وَأُولَٰئِكَ هُمُ الْمُفْلِحُونَ",
        "ar_plain": "واولئك هم المفلحون",
        "translit": "wa ulaa-ika humul-muflihuun",
        "en": "and it is they who are the successful (Al-Baqarah 2:5)",
        "ur": "اور یہی کامیاب ہیں (البقرہ 2:5)"
      },
      "explanation": {
        "en": "الْمُفْلِحُونَ is the predicate: nominative, ـُونَ.",
        "ur": "الْمُفْلِحُونَ خبر ہے: مرفوع، ـُونَ۔"
      }
    },
    {
      "type": "GRAMMAR_NOTE",
      "title": {
        "en": "Where the نَ goes",
        "ur": "نَ کہاں جاتا ہے"
      },
      "body": {
        "en": "The نَ stays in all three cases (ـُونَ / ـِينَ). It drops only when the plural is the first part of an iḍāfa: مُسْلِمُونَ → مُسْلِمُو الْمَدِينَةِ.",
        "ur": "نَ تینوں حالتوں میں باقی رہتا ہے (ـُونَ / ـِينَ)۔ یہ صرف اس وقت گرتا ہے جب جمع اضافت کا پہلا حصہ ہو: مُسْلِمُونَ ← مُسْلِمُو الْمَدِينَةِ۔"
      }
    }
  ],

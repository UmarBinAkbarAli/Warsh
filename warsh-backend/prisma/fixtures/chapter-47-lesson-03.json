    "noor_intro": {
      "en": "مُرْسِلُو النَّاقَةِ — \"senders of the she-camel\". مُرْسِلُونَ has lost its نَ because it is the first part of an iḍāfa.",
      "ur": "مُرْسِلُو النَّاقَةِ — \"اونٹنی کو بھیجنے والے\"۔ مُرْسِلُونَ کا نَ گر گیا ہے کیونکہ یہ اضافت کا پہلا حصہ ہے۔"
    }
  },
  "discover_cards": [
    {
      "type": "CONCEPT",
      "concept": {
        "en": "Iḍāfa drops the نَ",
        "ar": "حَذْفُ النُّونِ لِلْإِضَافَةِ",
        "ur": "اضافت میں نَ گرتا ہے"
      },
      "explanation": {
        "en": "The نَ stays in all three cases (ـُونَ / ـِينَ). It drops only when the plural is the first part of an iḍāfa: مُسْلِمُونَ → مُسْلِمُو الْمَدِينَةِ.",
        "ur": "نَ تینوں حالتوں میں باقی رہتا ہے (ـُونَ / ـِينَ)۔ یہ صرف اس وقت گرتا ہے جب جمع اضافت کا پہلا حصہ ہو: مُسْلِمُونَ ← مُسْلِمُو الْمَدِينَةِ۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "مُرْسِلُو النَّاقَةِ",
        "ar_plain": "مرسلو الناقة",
        "translit": "mursiluun-naaqa",
        "en": "senders of the she-camel (Al-Qamar 54:27)",
        "ur": "اونٹنی بھیجنے والے (القمر 54:27)"
      },
      "explanation": {
        "en": "مُرْسِلُونَ → مُرْسِلُو + النَّاقَةِ. Nominative (it is the predicate of إِنَّا), so ـُو.",
        "ur": "مُرْسِلُونَ ← مُرْسِلُو + النَّاقَةِ۔ مرفوع (إِنَّا کی خبر)، اس لیے ـُو۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "مُسْلِمُو الْمَدِينَةِ",
        "ar_plain": "مسلمو المدينة",
        "translit": "muslimul-madiina",
        "en": "the Muslims of the city (constructed)",
        "ur": "شہر کے مسلمان (بنائی گئی مثال)"
      },
      "explanation": {
        "en": "Nominative in iḍāfa: ـُو.",
        "ur": "اضافت میں مرفوع: ـُو۔"
      }
    },
    {
      "type": "EXAMPLE",
      "text": {
        "ar": "رَأَيْتُ مُسْلِمِي الْمَدِينَةِ",
        "ar_plain": "رايت مسلمي المدينة",
        "translit": "ra-aytu muslimil-madiina",
        "en": "I saw the Muslims of the city. (constructed)",
        "ur": "میں نے شہر کے مسلمانوں کو دیکھا۔ (بنائی گئی مثال)"
      },
      "explanation": {
        "en": "Accusative in iḍāfa: ـِي (from ـِينَ).",
        "ur": "اضافت میں منصوب: ـِي (ـِينَ سے)۔"
      }
    },
    {
      "type": "GRAMMAR_NOTE",
      "title": {
        "en": "Case still shows",
        "ur": "اعراب پھر بھی ظاہر ہے"
      },
      "body": {
        "en": "Without the نَ, the case still shows in the vowel letter: ـُو (nominative), ـِي (accusative/genitive).",
        "ur": "نَ کے بغیر بھی اعراب حرفِ علت سے ظاہر ہوتا ہے: ـُو (مرفوع)، ـِي (منصوب/مجرور)۔"
      }
    }
  ],

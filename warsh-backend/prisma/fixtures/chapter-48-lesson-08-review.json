  "discover_cards": [
    {
      "type": "CONCEPT",
      "concept": {
        "en": "Chapter 48 summary",
        "ar": "خُلَاصَةُ الْبَابِ",
        "ur": "باب 48 کا خلاصہ"
      },
      "explanation": {
        "en": "Clock time: السَّاعَةُ + an ordinal hour (السَّاعَةُ السَّابِعَةُ). Duration: a number + سَاعَاتٍ. 3–10: opposite gender, plural genitive noun (ثَلَاثَةُ أَيَّامٍ). 11–99: singular noun with fatḥa + tanwīn (أَحَدَ عَشَرَ كَوْكَبًا). 100 and 1000: singular genitive noun (مِائَةُ عَامٍ).",
        "ur": "گھڑی کا وقت: السَّاعَةُ + ترتیبی گھنٹہ (السَّاعَةُ السَّابِعَةُ)۔ مدت: عدد + سَاعَاتٍ۔ 3–10: الٹی جنس، جمع مجرور اسم (ثَلَاثَةُ أَيَّامٍ)۔ 11–99: واحد اسم فتحہ + تنوین کے ساتھ (أَحَدَ عَشَرَ كَوْكَبًا)۔ 100 اور 1000: واحد مجرور اسم (مِائَةُ عَامٍ)۔"
      }
    },
    {
      "type": "GRAMMAR_NOTE",
      "title": {
        "en": "Instrument or unit?",
        "ur": "آلہ یا اکائی؟"
      },
      "body": {
        "en": "مِيزَانٌ is the scale you weigh with. رِطْلٌ is a unit of weight, ذِرَاعٌ a unit of length, صَاعٌ and مُدٌّ units of volume.",
        "ur": "مِيزَانٌ وہ ترازو ہے جس سے تولتے ہیں۔ رِطْلٌ وزن کی اکائی، ذِرَاعٌ لمبائی کی اکائی، صَاعٌ اور مُدٌّ حجم کی اکائیاں ہیں۔"
      }
    }
  ],

  "discover_cards": [
    {
      "type": "CONCEPT",
      "concept": {
        "ar": "يَا — حرف النداء",
        "en": "يَا — O! (Vocative)",
        "ur": "يَا — اے! (ندا)"
      },
      "explanation": {
        "en": "يَا is used to call or address someone directly — like 'O!' or 'Hey!'.\n\nيَا رَبِّ = O my Lord!\nyَا مُحَمَّدُ = O Muhammad!\n\nImportant: When يَا precedes a name, the tanween disappears from that name.",
        "ur": "يَا کسی کو بلانے یا مخاطب کرنے کے لیے ہوتا ہے — جیسے 'اے!' یا 'یا!'۔\n\nيَا رَبِّ = اے میرے رب!\nyَا مُحَمَّدُ = اے محمد!\n\nاہم: جب يَا کسی نام سے پہلے آتا ہے تو اس نام کی تنوین ختم ہو جاتی ہے۔"
      }
    },
    {
      "text": {
        "ar": "يَا رَبِّ",
        "en": "O my Lord!",
        "ur": "اے میرے رب!",
        "ar_plain": "يا رب",
        "translit": "yā rabbi"
      },
      "type": "WORD",
      "audio_url": "https://pub-66b79e087e50463e9774c73769b4b8db.r2.dev/audio/vocab/ya-rabbi.mp3",
      "explanation": {
        "en": "يَا + رَبِّ (my Lord — ي attached = my). One of the most common duas in the Quran and in our speech.",
        "ur": "يَا + رَبِّ (میرا رب — ي لگا = میرا)۔ قرآن اور ہماری بولچال میں سب سے عام دعاؤں میں سے ایک۔"
      },
      "introduces_vocab": {
        "ar_plain": "يا رب"
